# ======================================================================
#  Cấu hình SpatialRepair — chép file này thành ".env" rồi điền vào.
#  File .env KHÔNG được đưa lên git (đã có trong .gitignore).
# ======================================================================

# ---------------- LLM (chỉ cần khi chạy bước 5: sinh SQL + đối chứng LLM) ----------------
# LLM_BACKEND: "mock" = LLM GIẢ (chạy thử, không tốn gì) | "openai" = mọi API theo chuẩn OpenAI
LLM_BACKEND=mock
LLM_MOCK_MODE=echo

# Khi có LLM thật: đổi LLM_BACKEND=openai rồi điền 3 dòng dưới. Ví dụ:
#   OpenAI      : LLM_BASE_URL=https://api.openai.com/v1           LLM_MODEL=gpt-4o-mini
#   DeepSeek    : LLM_BASE_URL=https://api.deepseek.com/v1         LLM_MODEL=deepseek-chat
#   Qwen (Alibaba DashScope): LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   OpenRouter  : LLM_BASE_URL=https://openrouter.ai/api/v1         LLM_MODEL=qwen/qwen-2.5-coder-32b-instruct
#   Ollama (máy): LLM_BASE_URL=http://localhost:11434/v1           LLM_MODEL=qwen2.5-coder:7b   (LLM_API_KEY để trống)
#   llama.cpp / LM Studio / vLLM trên máy: LLM_BASE_URL=http://localhost:8080/v1   LLM_MODEL=local
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=120
LLM_RETRIES=3
# JSON gửi kèm mỗi request. Qwen3 / Qwen3.5 (vLLM, SGLang): tắt chế độ "suy nghĩ" để nhanh, ít token:
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
LLM_EXTRA_BODY=

# ---------------- DuckDB / dữ liệu (để trống = dùng giá trị mặc định) ----------------
# Thư mục chứa 10 file parquet của FloodSQL-Bench (mặc định lấy trong data_source/paths.json)
PARQUET_DIR=
# Giới hạn RAM cho DuckDB, vd 6GB (để trống = không giới hạn)
DUCKDB_MEMORY_LIMIT=
DUCKDB_THREADS=
